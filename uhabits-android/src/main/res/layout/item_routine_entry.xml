<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Timeline indicator column -->
    <RelativeLayout
        android:layout_width="72dp"
        android:layout_height="match_parent">

        <!-- Vertical Timeline Line -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:background="?attr/contrast20" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Start time -->
            <TextView
                android:id="@+id/tvStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/contrast100"
                android:background="?attr/contrast0"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                tools:text="6:00 AM" />

            <!-- Timeline dot -->
            <View
                android:id="@+id/timelineDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/round_ripple"
                android:elevation="2dp" />

            <!-- End time -->
            <TextView
                android:id="@+id/tvEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/contrast60"
                android:background="?attr/contrast0"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                tools:text="7:00 AM" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Habit card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/contrast20"
        app:cardBackgroundColor="?attr/contrast0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="76dp">

            <!-- Habit color accent strip -->
            <View
                android:id="@+id/colorAccentStrip"
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:background="#4ADE80" />

            <!-- Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvHabitName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/contrast100"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Morning Exercise" />

                <!-- Duration Pill Chip -->
                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_routine_chip"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/contrast80"
                    tools:text="60 min" />
            </LinearLayout>

            <!-- Actions container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="12dp">

                <!-- Sync single entry button -->
                <ImageButton
                    android:id="@+id/btnSyncEntry"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_calendar_sync"
                    android:background="@drawable/bg_action_circle"
                    android:contentDescription="@string/sync_to_calendar"
                    android:padding="8dp"
                    app:tint="?attr/contrast80" />

                <!-- Delete button -->
                <ImageButton
                    android:id="@+id/btnDeleteEntry"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_delete"
                    android:background="@drawable/bg_action_circle"
                    android:contentDescription="@string/delete"
                    android:padding="8dp"
                    app:tint="?attr/contrast80" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

